{
  "name": "kizashi-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kizashi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kizashi-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "threads:verify-publish": "tsx scripts/verify-threads-publish.ts"
  },
  "dependencies": {
    "hono": "^4",
    "kizashi-core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1",
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4",
    "wrangler": "^4"
  }
}
